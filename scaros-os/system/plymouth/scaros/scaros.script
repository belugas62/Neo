# Scaros OS : le logo apparaît en fondu, un point lumineux balaie la ligne dessous.
# Fond noir, comme l'animation du menu qui prend le relais.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

w = Window.GetWidth();
h = Window.GetHeight();

logo.raw = Image("logo.png");
logo.width = w * 0.3;
logo.image = logo.raw.Scale(logo.width, logo.width * logo.raw.GetHeight() / logo.raw.GetWidth());
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + (w - logo.image.GetWidth()) / 2;
logo.y = Window.GetY() + (h - logo.image.GetHeight()) / 2;
logo.sprite.SetPosition(logo.x, logo.y, 1);
logo.sprite.SetOpacity(0);

dot.raw = Image("dot.png");
dot.image = dot.raw.Scale(logo.width * 0.09, logo.width * 0.09 * dot.raw.GetHeight() / dot.raw.GetWidth());
dot.sprite = Sprite(dot.image);
track.width = logo.width * 0.45;
track.x = Window.GetX() + (w - track.width) / 2;
dot.sprite.SetY(logo.y + logo.image.GetHeight() + h * 0.09);
dot.sprite.SetZ(2);
dot.sprite.SetOpacity(0);

t = 0;
fun refresh_callback ()
{
  t++;
  fade = t / 45;
  if (fade > 1) fade = 1;
  logo.sprite.SetOpacity(fade);
  p = (Math.Sin(t / 22) + 1) / 2;
  dot.sprite.SetX(track.x + p * (track.width - dot.image.GetWidth()));
  dot.sprite.SetOpacity(fade * 0.85);
}
Plymouth.SetRefreshFunction(refresh_callback);
