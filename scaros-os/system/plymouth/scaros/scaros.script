# Scaros OS : écran de démarrage, comme la maquette du kit du logo.
# Sur fond noir, le symbole apparaît en fondu, ses deux fentes s'allument en ambre,
# puis « scaros » apparaît dessous. Ensuite les fentes « respirent » doucement
# jusqu'à ce que le menu prenne le relais (avec la même animation, en plus long).
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

w = Window.GetWidth();
h = Window.GetHeight();
size = h * 0.203;                  # maquette : symbole de 220 px sur un écran de 1080
if (size > w * 0.3) size = w * 0.3;
x = Window.GetX() + (w - size) / 2;
y = Window.GetY() + h * 0.361;

# le corps blanc (fentes découpées) passe devant les fentes ambre
body.image = Image("symbol.png").Scale(size, size);
body.sprite = Sprite(body.image);
body.sprite.SetPosition(x, y, 2);
body.sprite.SetOpacity(0);

slots.image = Image("slots.png").Scale(size, size);
slots.sprite = Sprite(slots.image);
slots.sprite.SetPosition(x, y, 1);
slots.sprite.SetOpacity(0);

word.raw = Image("word.png");
word.width = size * 0.8667;
word.image = word.raw.Scale(word.width, word.width * word.raw.GetHeight() / word.raw.GetWidth());
word.sprite = Sprite(word.image);
word.sprite.SetPosition(Window.GetX() + (w - word.width) / 2, y + size * 1.29, 1);
word.sprite.SetOpacity(0);

fun clamp (v)
{
  if (v < 0) return 0;
  if (v > 1) return 1;
  return v;
}

# départ rapide, arrivée tout en douceur
fun ease (v)
{
  v = clamp(v);
  return 1 - (1 - v) * (1 - v) * (1 - v);
}

t = 0;
fun refresh_callback ()
{
  t++;                                          # environ 50 images par seconde
  body.sprite.SetOpacity(ease((t - 10) / 45));
  glow = ease((t - 50) / 30);
  if (t > 110) glow = 0.8 + 0.2 * Math.Cos((t - 110) / 30);
  slots.sprite.SetOpacity(glow);
  word.sprite.SetOpacity(ease((t - 80) / 40));
}
Plymouth.SetRefreshFunction(refresh_callback);
